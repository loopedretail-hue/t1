  "curl_examples": [
    {
      "name": "Master Workflow - Bash",
      "command": "curl -X POST https://your-n8n-instance.com/webhook/product-to-scripts \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"productUrl\": \"https://www.example.com/product\",\n    \"scriptCount\": 5,\n    \"scriptLength\": \"60s\",\n    \"selectedAngles\": \"all\"\n  }'"
    },
    {
      "name": "Research Only - Bash",
      "command": "curl -X POST https://your-n8n-instance.com/webhook/product-research \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"productUrl\": \"https://www.example.com/product\"\n  }'"
    },
    {
      "name": "Master Workflow - JavaScript/Node.js",
      "code": "const axios = require('axios');\n\nconst response = await axios.post(\n  'https://your-n8n-instance.com/webhook/product-to-scripts',\n  {\n    productUrl: 'https://www.example.com/product',\n    scriptCount: 5,\n    scriptLength: '60s',\n    selectedAngles: 'all'\n  },\n  {\n    headers: { 'Content-Type': 'application/json' }\n  }\n);\n\nconsole.log(response.data);"
    },
    {
      "name": "Master Workflow - Python",
      "code": "import requests\nimport json\n\nurl = 'https://your-n8n-instance.com/webhook/product-to-scripts'\nheaders = {'Content-Type': 'application/json'}\ndata = {\n    'productUrl': 'https://www.example.com/product',\n    'scriptCount': 5,\n    'scriptLength': '60s',\n    'selectedAngles': 'all'\n}\n\nresponse = requests.post(url, headers=headers, data=json.dumps(data))\nprint(response.json())"
    }
